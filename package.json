{
  "name": "mystorage-grounded-answers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype fix for stow.mystorage.vn: ground the assistant's numeric answers in a single source of truth, and regression-test them against real transcripts.",
  "scripts": {
    "dev": "concurrently -k -n vite,server \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/prompts.test.ts src/lib/grader.test.ts src/lib/concurrency.test.ts src/data/testset.test.ts",
    "eval": "tsx src/evals/runPromptEval.ts",
    "eval:transcript": "tsx src/evals/run.ts",
    "models": "tsx src/scripts/listModels.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
